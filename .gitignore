!data/neighborhoods.json
!data/nyc_boundary.geojson
!data/footprints.json
data/_fp_build_cache/
data/sample2983_backup/
docs/
# ...except the public write-up deliverable (re-include its dir, but keep
# every other file in that dir ignored)
!docs/context/
docs/context/*
!docs/context/visualization-findings.md

# Claude Code local config (transcripts, personal settings, local hooks)
.claude/save-chat-state.json
.claude/hooks/

.vercel
.env*

