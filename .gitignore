.env
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
data/*.csv
data/*.json
data/*.geojson
data/*.bak
data/*.superseded*
data/*.pre-geocode
data/*.pre-lens-metrics
!data/.gitkeep
# The site fetches these directly - Vercel deploys straight from git, so they
# have to actually be tracked, not just allowed through .vercelignore.
!data/neighborhoods.json
!data/nyc_boundary.geojson
# map_dataset.json and footprints.json are deliberately NOT tracked any more:
# at 55MB and 36MB they tripped GitHub's large-file warning. They are the
# pipeline's canonical intermediates, and scripts/build_web_data.py packs them
# into the small per-borough slices in data/web/ that the site actually loads.
# (data/web/ isn't matched by the data/*.json rule above - that glob doesn't
# cross a directory separator - so those slices are tracked automatically.)
data/_fp_build_cache/
data/sample2983_backup/
docs/
# ...except the public write-up deliverable (re-include its dir, but keep
# every other file in that dir ignored)
!docs/context/
docs/context/*
!docs/context/visualization-findings.md

# Claude Code local config (transcripts, personal settings, local hooks)
.claude/save-chat-state.json
.claude/hooks/

.vercel
.env*

# Local-only copies of design mockups published as Claude artifacts during
# this project's work - not part of the shipped site, kept for reference.
local-artifacts/
