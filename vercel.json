{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "^hdp-.*\\.vercel\\.app$" }
      ],
      "destination": "https://nyc-building-stories.vercel.app/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/map.html" }
  ]
}
