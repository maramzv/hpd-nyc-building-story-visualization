# Creating this file makes Vercel stop reading .gitignore, so everything
# needed at runtime has to be explicitly allowed here (map.html loads
# src/building_story.js and the three data/ files below directly).

# Python offline data pipeline - never runs on Vercel, and its presence
# (esp. requirements.txt) is what made Vercel try to build a Python
# environment for what is actually a static site.
.venv/
requirements.txt
scripts/
notebooks/
src/*.py
.env
.env.example

# Not needed to serve the site
docs/
.claude/
README.md

# data/ holds many large intermediate/raw pipeline files (some 1GB+) that
# .gitignore normally keeps out of git - only what the site actually fetches
# should be uploaded. data/web/ is the built output of
# scripts/build_web_data.py (per-borough building + footprint slices and the
# landing summary); map_dataset.json/footprints.json are its inputs and are
# never served.
data/*
# Negating the directory alone (!data/web/) does not reliably unignore its
# contents on Vercel's ignore matcher - unlike plain .gitignore semantics,
# it left every file inside 404ing on the live deploy even though they were
# tracked in git. The glob has to target the files directly.
!data/web/**
!data/neighborhoods.json
!data/nyc_boundary.geojson
